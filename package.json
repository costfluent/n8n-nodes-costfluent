{
	"name": "n8n-nodes-costfluent",
	"version": "0.1.0",
	"description": "n8n nodes for Costfluent: trigger workflows on cloud cost events and read costs, reports, budgets and anomalies",
	"license": "MIT",
	"homepage": "https://github.com/costfluent/n8n-nodes-costfluent#readme",
	"bugs": {
		"url": "https://github.com/costfluent/n8n-nodes-costfluent/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"costfluent",
		"finops",
		"cloud-cost"
	],
	"author": {
		"name": "Costfluent",
		"email": "ops@costfluent.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/costfluent/n8n-nodes-costfluent.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CostfluentApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Costfluent/Costfluent.node.js",
			"dist/nodes/CostfluentTrigger/CostfluentTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.52.6",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
